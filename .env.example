# --- Sitio ---
SITE_URL=https://www.datovatenexuspro.com

# --- Base de datos (opcional en el primer deploy: el sitio funciona sin ella) ---
# Esquema `web` — correr migrations/001_init.sql antes de activar
DATABASE_URL=postgres://usuario:clave@host:5432/basededatos

# --- Agente (OpenRouter) ---
OPENROUTER_API_KEY=
# Elegir un modelo potente y económico en el panel de OpenRouter y ponerlo aquí.
# El sufijo :floor enruta siempre al proveedor más barato con failover.
# "openrouter/auto" funciona como arranque si no quieres elegir todavía.
OPENROUTER_MODEL=openrouter/auto
# Corte duro de gasto mensual del chat en USD (se degrada a formulario al superarlo)
LLM_BUDGET_USD=25

# --- Correo (SendGrid) ---
SENDGRID_API_KEY=
MAIL_FROM=contacto@datovatenexuspro.com
MAIL_TO=contacto@datovatenexuspro.com

# --- Contacto ---
WHATSAPP_NUMBER=573205046277

# --- SEO ---
NEXT_PUBLIC_GA_ID=
INDEXNOW_KEY=
